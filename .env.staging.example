# Staging: a second Supabase project that mirrors production, so a change can be
# tried out on real infrastructure before it touches real people's pay.
#
# 1. Create a separate Supabase project (not the production one).
# 2. Copy this file to .env.staging (it is git-ignored) and fill it in.
# 3. Build the database:   npm run migrate:staging            (shows the plan)
#                          npm run migrate:staging -- --confirm <host from the plan>
# 4. Deploy the edge functions to it (see supabase/README.md).
# 5. Build the client with the staging keys:  VITE_SUPABASE_URL=... npm run build

# Used by scripts/migrate.mjs. Supabase: Project settings > Database > Connection string (URI).
DATABASE_URL=postgres://postgres:YOUR-PASSWORD@db.YOUR-STAGING-REF.supabase.co:5432/postgres

# Optional: path to the project's CA certificate to verify the database fully.
# DATABASE_CA=./certs/supabase-staging-ca.crt

# For the client build (the same two values as client/.env, but the staging project's).
VITE_SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-STAGING-ANON-KEY

# Mark the environment in error reports, and optionally report errors to Sentry.
VITE_APP_ENV=staging
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
